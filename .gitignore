# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Server runtime (not needed in repo)
*.bak
*.bak-*
server.log
runtime.json
runtime.lock
runtime.json.tmp
kanban.lock

# SQLite WAL files
*.db-shm
*.db-wal

# Private — internal planning, business docs (not for public repo)
private/
.gstack/
.rocketride/
.vc/

# Local secrets and external tool footprints
.env
.env.*
.claude/
# .github 아래 로컬 흔적은 제외하되, CI 워크플로·이슈 템플릿은 반드시 추적한다.
# (디렉토리째 제외하면 하위를 되살릴 수 없어 `.github/*` 형태여야 한다)
# 워크플로가 한 번 이 규칙에 걸려 안 올라간 적이 있다(90ef2a9) — 이슈 템플릿도
# 같은 함정이라 같은 방식으로 예외를 둔다.
.github/*
!.github/workflows/
!.github/ISSUE_TEMPLATE/

# e2e 스킬 검증용 임시 산출물
test_temp/
.check-venv/

# 커버리지 산출물 — SQLite 바이너리이고 절대경로를 담는다.
# 실수로 추적되고 있었다(48fedfa). 머신마다 다르게 바뀌어 병합도 안 된다.
.coverage
.coverage.*
htmlcov/
