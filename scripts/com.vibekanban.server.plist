<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vibekanban.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/.claude/kanban/server.py</string>
        <string>serve</string>
        <string>4242</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/kanban/server.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/kanban/server.log</string>

    <key>WorkingDirectory</key>
    <string>__HOME__/.claude/kanban</string>

    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
